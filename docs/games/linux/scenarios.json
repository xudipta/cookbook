  "events": [
    {
      "id": "perm-denied",
      "title": "CI cannot run the deploy script",
      "fix": "`ls -l` shows the owner and the `x` bits. The deploy user is \"other\" here, and other had no `x`. `chmod +x` (or `755`) fixes it without opening the file to everyone.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Permissions"
      }
    },
    {
      "id": "runaway",
      "title": "Load average is 38",
      "fix": "`ps aux --sort=-%cpu` (or `top`) names the process pinning the CPU. Ask it to stop with `kill PID` (SIGTERM) so it can clean up; `kill -9` is the last resort.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Processes"
      }
    },
    {
      "id": "hung-process",
      "title": "A job is stuck at 99% CPU and ignores kill",
      "fix": "SIGTERM is a request, and a wedged process may ignore it. When a plain `kill PID` changes nothing, `kill -9 PID` (SIGKILL) ends it without asking.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Processes"
      }
    },
    {
      "id": "disk-full",
      "title": "The disk is full and writes are failing",
      "fix": "`df -h` finds the full filesystem; `du -sh /var/log/*` or `find / -size +1G` finds what filled it. If a process still has the file open, truncate it (`truncate -s 0 FILE`) instead of deleting it.",
      "learn": {
        "note": "topics/linux/notes/03-systemd-and-networking.md",
        "section": "Disk and resource usage"
      }
    },
    {
      "id": "needle-500s",
      "title": "Users are seeing 500 errors",
      "fix": "One client causes most of the 500s. `grep 500 access.log | awk '{print $1}' | sort | uniq -c | sort -rn` counts errors per client. Block the offender, then reload nginx so the running config changes.",
      "learn": {
        "note": "topics/linux/notes/02-text-processing.md",
        "section": "Putting it together"
      }
    },
    {
      "id": "crash-loop",
      "title": "A service restarts forever",
      "fix": "`systemctl status` shows the crash loop and the last log lines; `journalctl -u NAME` shows why. Fix the cause, run `systemctl daemon-reload` if you edited the unit file, and restart.",
      "learn": {
        "note": "topics/linux/notes/03-systemd-and-networking.md",
        "section": "systemd services"
      }
    },
    {
      "id": "nothing-listening",
      "title": "Connection refused: nothing is listening",
      "fix": "`ss -tlnp` shows which address and port each process is bound to. A service on 127.0.0.1 is invisible from outside, and the wrong port is invisible to everyone. Fix the config, restart, and verify with `curl -I`.",
      "learn": {
        "note": "topics/linux/notes/03-systemd-and-networking.md",
        "section": "Networking"
      }
    },
    {
      "id": "backup-lies",
      "title": "Backups are empty but the job says success",
      "fix": "Without `set -euo pipefail` a failing `tar` is ignored and the script goes on to print success. Add it so failures are loud, fix the path cron passes, and check `$?`.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Writing scripts that don't surprise you"
      }
    },
    {
      "id": "unit-perm",
      "title": "The worker crash-loops after a deploy",
      "fix": "The journal says \"permission denied\": a deploy left the data directory owned by root. `ls -ld` shows the owner; `chown` it back to the service user and the unit starts on its next retry.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Permissions"
      }
    },
    {
      "id": "killed-init",
      "title": "You signalled PID 1",
      "fix": "PID 1 is the parent of every process. Killing it takes the whole host down. Take the PID from `ps`, never from a guess.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Processes"
      }
    },
    {
      "id": "rm-wrong",
      "title": "rm removed something the system needs",
      "fix": "Delete the one file that filled the disk, not a directory. Check what you are about to remove with `ls -l` or `find ... -print` first.",
      "learn": {
        "note": "topics/linux/notes/02-text-processing.md",
        "section": "find — locate files, act on them"
      }
    },
    {
      "id": "deleted-open-file",
      "title": "You deleted a file a process still has open",
      "fix": "The space does not come back until the process closes the file. Truncate it (`truncate -s 0 FILE` or `: > FILE`), or restart the process that holds it.",
      "learn": {
        "note": "topics/linux/notes/03-systemd-and-networking.md",
        "section": "Disk and resource usage"
      }
    },
    {
      "id": "kill-9-first",
      "title": "SIGKILL before SIGTERM",
      "fix": "`kill -9` cannot be caught, so the process cannot clean up its locks and temp files. Send a plain `kill PID` first and escalate only if it is ignored.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Processes"
      }
    },
    {
      "id": "killed-service",
      "title": "You took down a healthy service",
      "fix": "Match the PID to its command in `ps aux` before you kill it. To restart a service, use `systemctl restart NAME`, not `kill`.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Processes"
      }
    },
    {
      "id": "blocked-healthy",
      "title": "You blocked a healthy client",
      "fix": "The busiest client is not the broken one. Filter by status (`grep 500`) before you count, so you block the source of the errors, not of the traffic.",
      "learn": {
        "note": "topics/linux/notes/02-text-processing.md",
        "section": "Putting it together"
      }
    },
    {
      "id": "wide-open-perms",
      "title": "chmod gave everyone write access",
      "fix": "`777` or `o+w` lets any user change the file. Add only what is needed: `chmod +x`, or `755` for a script.",
      "learn": {
        "note": "topics/linux/notes/01-shell-fundamentals.md",
        "section": "Permissions"
      }
    },
    {
      "id": "blind-fix",
      "title": "You changed something before looking",
      "fix": "Follow the order: status, then logs, then resources, then network. Look first, change one thing, look again.",
      "learn": {
        "note": "topics/linux/notes/03-systemd-and-networking.md",
        "section": "Quick troubleshooting order"
      }
    }
  ],
