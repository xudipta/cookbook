    {
      "id": "storm-night",
      "title": "3. Storm night",
      "blurb": "The earlier rules are in place. Now a rack goes dark and fifteen alerts fire at once, a scrape flap looks like an outage, and the request-rate panel is too slow to use while you debug. Group the storm, tame the flap, and record the expensive query.",
      "hints": [
        "Look at the Alertmanager route: with nothing grouped, fifteen alerts mean fifteen pages.",
        "Group by alertname and job so a dead rack is one page, ride out a flapping scrape with a for clause, and record the expensive query as a rule.",
        "Set group_by to alertname,job, save the InstanceDown rule with a for duration, add a recording rule for the request rate, then Run to morning."
      ],
      "seed": 19,
      "winTicks": 9,
      "budgetMin": 100,
      "sloTarget": 60,
      "minSleep": 70,
      "groupBy": "...",
      "rules": [
        {
          "id": "r1",
          "name": "HighErrorRatio",
          "metric": "err",
          "fn": "ratio",
          "op": ">",
          "threshold": 0.05,
          "for": "5m",
          "severity": "critical",
          "window": "5m"
        },
        {
          "id": "r2",
          "name": "HighP95Latency",
          "metric": "lat",
          "fn": "quantile",
          "q": 0.95,
          "op": ">",
          "threshold": 0.5,
          "for": "5m",
          "severity": "critical",
          "window": "5m"
        },
        {
          "id": "r3",
          "name": "DiskFillingUp",
          "metric": "disk",
          "fn": "predict_linear",
          "op": "<",
          "threshold": 0,
          "for": "5m",
          "severity": "critical",
          "window": "1h",
          "horizon": 4
        },
        {
          "id": "r4",
          "name": "HighCPU",
          "metric": "cpu",
          "fn": "raw",
          "op": ">",
          "threshold": 0.9,
          "for": "10m",
          "severity": "warning"
        },
        {
          "id": "r5",
          "name": "InstanceDown",
          "metric": "up",
          "fn": "raw",
          "op": "<",
          "threshold": 1,
          "for": "0m",
          "severity": "critical"
        }
      ],
      "history": [
