{
  "id": "docker",
  "title": "Layer Cake",
  "healthLabel": "Build budget",
  "tickLabel": "Build",
  "manual": true,
  "seed": 1,
  "events": [
    {
      "id": "dev-edit-src",
      "title": "A teammate edited a source file",
      "fix": "COPY and ADD are cache-busted by the content of the files they copy, so that layer and every layer after it rebuild. Copy the dependency manifest and install first, and the slow install stays cached.",
      "learn": {
        "note": "topics/docker/notes/02-multi-stage-builds-and-caching.md",
        "section": "How the layer cache works"
      }
    },
    {
      "id": "dev-add-dep",
      "title": "A teammate changed the dependency manifest",
      "fix": "A changed manifest legitimately re-runs the install. That is the point of copying it on its own first: the install reruns only when the manifest changes, not on every code edit.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Dockerfile tips"
      }
    },
    {
      "id": "base-bump",
      "title": "The base image was updated upstream",
      "fix": "A new base layer changes the cache key of everything built on it, so every layer rebuilds. Pin base image tags so that only happens when you choose.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Dockerfile tips"
      }
    },
    {
      "id": "cold-runner",
      "title": "CI started on a fresh runner with an empty cache",
      "fix": "With no cache every layer rebuilds. Carry a cache between runs: --cache-from, or cache-from/cache-to in docker/build-push-action.",
      "learn": {
        "note": "topics/docker/notes/02-multi-stage-builds-and-caching.md",
        "section": "Build cache in CI"
      }
    },
    {
      "id": "err-no-from",
      "title": "The build failed: the Dockerfile does not start with FROM",
      "fix": "Every Dockerfile begins with FROM; any other instruction before it has no build stage to run in.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Debugging a build"
      }
    },
    {
      "id": "err-bad-tag",
      "title": "The build failed: the base image tag does not exist",
      "fix": "The registry has no such tag. Read the first ERROR line of the build log: it names the image it could not resolve.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Debugging a build"
      }
    },
    {
      "id": "err-missing-input",
      "title": "The build failed: an instruction ran before its inputs were there",
      "fix": "Each instruction only sees what earlier layers put in the image. Read the failing step in the log, then check what it needs (a copied file, an installed dependency) is placed above it.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Debugging a build"
      }
    },
    {
      "id": "err-bad-stage",
      "title": "The build failed: COPY --from names a stage that does not exist",
      "fix": "COPY --from=NAME needs an earlier FROM ... AS NAME. Name the build stage, and copy from it only after the final stage's FROM.",
      "learn": {
        "note": "topics/docker/notes/02-multi-stage-builds-and-caching.md",
        "section": "Why multi-stage"
      }
    },
    {
      "id": "bloat",
      "title": "The image is bigger than it needs to be",
      "fix": "A single-stage image ships the compiler, dev dependencies and source it only needed to build. Build in one stage and copy just the artifact into a small runtime stage.",
      "learn": {
        "note": "topics/docker/notes/02-multi-stage-builds-and-caching.md",
        "section": "Why multi-stage"
      }
    },
    {
      "id": "no-start",
      "title": "The image builds but the container would not start",
      "fix": "A successful build only means every instruction ran. The container still needs a CMD (or a base image that has one), the files it runs, and any USER it names to exist.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Quick reference"
      }
    },
    {
      "id": "secret-leak",
      "title": "A secret (.env) was baked into the image",
      "fix": "COPY . . copies everything in the build context, including .env. List secrets, .git and local dependency folders in a .dockerignore so they never enter the context or the image.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Dockerfile tips"
      }
    },
    {
      "id": "ctx-bloat",
      "title": "The build context is huge",
      "fix": "Docker sends the whole context to the builder on every build, and COPY . . puts all of it in a layer. A .dockerignore keeps .git, node_modules and virtualenvs out.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Dockerfile tips"
      }
    },
    {
      "id": "apt-cache",
      "title": "Package-manager cache was left in the image",
      "fix": "Files deleted in a later layer still exist in the earlier one, so cleanup has to happen in the same RUN that created them (apt-get install ... && rm -rf /var/lib/apt/lists/*).",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Dockerfile tips"
      }
    },
    {
      "id": "root-user",
      "title": "The container runs as root",
      "fix": "The base image's default user is often root. Create an unprivileged user and switch to it with USER before CMD.",
      "learn": {
        "note": "topics/docker/notes/01-images-and-dockerfiles.md",
        "section": "Dockerfile tips"
      }
    },
    {
      "id": "cmp-localhost",
      "title": "The api cannot reach the database: it connects to localhost",
      "fix": "Inside a container, localhost is the container itself. Services in a Compose project reach each other by service name, so point the api at db:5432.",
      "learn": {
        "note": "topics/docker/notes/03-compose-and-networking.md",
        "section": "Networking"
      }
    },
    {
      "id": "cmp-db-not-ready",
      "title": "The api started before the database accepted connections",
      "fix": "depends_on only orders container start, not readiness. Give db a healthcheck and make the api wait with condition: service_healthy.",
      "learn": {
        "note": "topics/docker/notes/03-compose-and-networking.md",
        "section": "Compose basics"
      }
    },
    {
      "id": "cmp-no-healthcheck",
      "title": "The api waits for a healthy database, but db has no healthcheck",
      "fix": "condition: service_healthy needs a healthcheck on the service it waits for. Add one (pg_isready for Postgres).",
      "learn": {
        "note": "topics/docker/notes/03-compose-and-networking.md",
        "section": "Compose basics"
      }
    },
    {
      "id": "cmp-undefined-volume",
      "title": "Compose rejected the project: the volume is not declared",
      "fix": "A named volume used by a service must also be declared in the top-level volumes: section.",
      "learn": {
        "note": "topics/docker/notes/03-compose-and-networking.md",
        "section": "Volumes"
      }
    },
    {
      "id": "cmp-data-lost",
      "title": "The database lost its data after down and up",
      "fix": "Data written to a container's writable layer is gone when the container is removed. Keep database data in a named volume.",
      "learn": {
        "note": "topics/docker/notes/03-compose-and-networking.md",
        "section": "Volumes"
      }
    },
    {
      "id": "cmp-published-db",
      "title": "The database port is published to the host",
      "fix": "Container-to-container traffic never needs a published port. Publish only what something outside Docker needs (web), and keep db off the host.",
      "learn": {
        "note": "topics/docker/notes/03-compose-and-networking.md",
        "section": "Networking"
      }
    },
    {
      "id": "cmp-no-web-port",
      "title": "The web service is not reachable from the host",
      "fix": "A service is only reachable from outside Docker when it publishes a port, for example ports: [\"8080:80\"].",
      "learn": {
        "note": "topics/docker/notes/03-compose-and-networking.md",
        "section": "Networking"
      }
    },
    {
      "id": "cmp-bind-mount",
      "title": "The database data lives in a bind mount",
      "fix": "A bind mount survives down, but it ties the stack to one host path and is not portable or reproducible in CI. Use a named volume for data you want to keep.",
      "learn": {
        "note": "topics/docker/notes/03-compose-and-networking.md",
        "section": "Volumes"
      }
    }
  ],
