  "events": [
    {
      "id": "wrong-transport",
      "title": "A server was wired with the wrong transport",
      "fix": "A local process you launch is stdio (`command` + `args`); a hosted server is Streamable HTTP (`--transport http` and a URL). A URL launched as a command fails with `spawn ... ENOENT`, and the old SSE transport has been folded into Streamable HTTP.",
      "learn": {
        "note": "topics/mcp/notes/01-mcp-overview.md",
        "section": "Transports"
      }
    },
    {
      "id": "connect-failed",
      "title": "A client cannot connect to a server",
      "fix": "The client runs the handshake first: `initialize`, `notifications/initialized`, then `tools/list`. A process that exits, a package that does not exist or a URL that does not answer fails it, and then none of that server's tools exist. Read the error and the server's own usage line, then fix the entry.",
      "learn": {
        "note": "topics/mcp/notes/01-mcp-overview.md",
        "section": "The handshake"
      }
    },
    {
      "id": "needs-auth",
      "title": "A server answers 401: you are not authenticated",
      "fix": "Pass the token in `headers` as `Bearer ${VAR}` (or in `env` for a stdio server), and check it is the token that server expects. OAuth servers are signed in from a session with `/mcp`.",
      "learn": {
        "note": "topics/mcp/notes/02-mcp-in-claude-code.md",
        "section": "Secrets and authentication"
      }
    },
    {
      "id": "secret-committed",
      "title": "A token landed in the committed .mcp.json",
      "fix": "Everything in `.mcp.json` goes to git. Put `${VAR}` in the file and keep the value in your shell. Single-quote it on the command line so your shell does not expand it first, and rotate the token that leaked.",
      "learn": {
        "note": "topics/mcp/notes/02-mcp-in-claude-code.md",
        "section": ".mcp.json"
      }
    },
    {
      "id": "teammate-clones",
      "title": "A teammate clones the repo",
      "fix": "A fresh clone only has what is committed: `.mcp.json`, the project scope. Entries that use `${VAR}` pick up each person's own token from their environment.",
      "learn": {
        "note": "topics/mcp/notes/02-mcp-in-claude-code.md",
        "section": "Config scopes"
      }
    },
    {
      "id": "not-shared",
      "title": "A teammate cannot reach a server you can",
      "fix": "`local` and `user` scope live in your own `~/.claude.json`. A server the whole team needs belongs in `project` scope (`--scope project`), which writes `.mcp.json` and travels with git. The default scope is `local`.",
      "learn": {
        "note": "topics/mcp/notes/02-mcp-in-claude-code.md",
        "section": "Config scopes"
      }
    },
    {
      "id": "shadowed",
      "title": "An old entry shadows the team's server",
      "fix": "When names collide the more specific scope wins (`local`, then `project`, then `user`), so a stale local entry silently replaces the shared one. `claude mcp get NAME` shows which scope answers; remove the old one with `claude mcp remove NAME --scope local`.",
      "learn": {
        "note": "topics/mcp/notes/02-mcp-in-claude-code.md",
        "section": "Config scopes"
      }
    },
    {
      "id": "admin-token",
      "title": "A server holds an org-admin token",
      "fix": "A server only needs the access its tools use. Wire the narrowest token (fine-grained, read-only), so a bug or a hijacked agent cannot delete repositories or change org settings.",
      "learn": {
        "note": "topics/mcp/notes/03-building-a-server.md",
        "section": "Security checklist"
      }
    },
    {
      "id": "wrong-primitive",
      "title": "A request used the wrong primitive",
      "fix": "Tools are actions the model invokes (`mcp__server__tool`). Resources are read-only data you attach by URI (`@server:uri`). Prompts are templates you run yourself (`/server:name`). Asking for one with another's mechanism fails.",
      "learn": {
        "note": "topics/mcp/notes/01-mcp-overview.md",
        "section": "The three primitives"
      }
    },
    {
      "id": "unvetted-server",
      "title": "A teammate's commit adds a server you have not vetted",
      "fix": "Project servers wait for approval because the file is shared. Approve only after you know what the server is and what its tools say: it is code you run and text the model will obey. Reject or remove what you do not trust.",
      "learn": {
        "note": "topics/mcp/notes/01-mcp-overview.md",
        "section": "Trust"
      }
    },
    {
      "id": "tool-poisoning",
      "title": "A tool description hides instructions for the model",
      "fix": "Tool descriptions are text the model reads and follows. Inspect them (`npx @modelcontextprotocol/inspector --cli ... --method tools/list`) before you connect an untrusted server, and do not connect one whose descriptions ask for anything beyond the tool's job.",
      "learn": {
        "note": "topics/mcp/notes/01-mcp-overview.md",
        "section": "Trust"
      }
    },
    {
      "id": "compromised",
      "title": "The agent followed hidden instructions and leaked secrets",
      "fix": "A connected server's tool descriptions sit in the model's context for every request, so one poisoned tool can steer calls made for other servers. Do not connect untrusted servers; read descriptions first.",
      "learn": {
        "note": "topics/mcp/notes/01-mcp-overview.md",
        "section": "Trust"
      }
    },
    {
      "id": "weak-interface",
      "title": "The agent cannot make sense of the tool",
      "fix": "The model only has the name, the description and the input schema to go on. Name tools by action, say what they do, when to use them and what they return, and type every input.",
      "learn": {
        "note": "topics/mcp/notes/03-building-a-server.md",
        "section": "Design guidelines"
      }
    },
    {
      "id": "bloated-result",
      "title": "A tool dumped far too much text into the context",
      "fix": "A tool result lands in the model's context. Return the concise answer (the count, not the document) and paginate or summarise anything large.",
      "learn": {
        "note": "topics/mcp/notes/03-building-a-server.md",
        "section": "Design guidelines"
      }
    },
    {
      "id": "invalid-result",
      "title": "A handler returned something that is not a tool result",
      "fix": "A handler returns `{ content: [{ type: \"text\", text }] }`. Anything else fails the client's validation of the `tools/call` result. Test with the inspector before you plug a server in.",
      "learn": {
        "note": "topics/mcp/notes/03-building-a-server.md",
        "section": "Minimal server (TypeScript SDK)"
      }
    }
  ],
  "levels": [
    {
      "id": "first-plugs",
      "title": "1. First plugs",
      "blurb": "Wire a local filesystem server (stdio) and the hosted Grafana (Streamable HTTP) into the project's .mcp.json. A teammate clones the repo halfway through, and no token may land in git.",
      "hints": [
        "Look at the requests: each needs a server that is not wired yet.",
        "A local server runs a command (stdio) and a hosted one is a URL (HTTP). Project scope writes .mcp.json, which goes in git, so no token may go in it.",
        "claude mcp add filesystem with --scope project and its npx command, then Grafana with --transport http and the token as ${GRAFANA_TOKEN}, never its value."
      ],
      "winTicks": 4,
      "catalog": [
        "filesystem",
        "grafana"
      ],
      "env": [
        "GRAFANA_TOKEN"
      ],
      "files": {
        "project": null,
        "local": {},
        "user": {}
      },
      "requests": [
        {
          "id": "r1",
          "as": "you",
          "text": "List the files in ./docs",
          "kind": "tool",
          "server": "filesystem",
          "name": "list_directory",
          "args": {
            "path": "./docs"
          },
          "result": "[FILE] index.md\n[FILE] setup.md\n[FILE] troubleshooting.md",
          "reply": "3 files in ./docs"
        },
        {
          "id": "r2",
          "as": "you",
          "text": "Is the checkout dashboard healthy?",
          "kind": "tool",
          "server": "grafana",
          "name": "get_dashboard_summary",
          "args": {
            "uid": "checkout-latency"
          },
          "result": "checkout-latency: p95 212 ms (SLO 300 ms), error rate 0.08%. No alerts firing.",
          "reply": "p95 212 ms, no alerts"
        },
        {
          "id": "r3",
          "as": "teammate",
          "text": "Open docs/setup.md",
          "kind": "tool",
          "server": "filesystem",
          "name": "read_file",
          "args": {
            "path": "./docs/setup.md"
          },
          "result": "# Setup\n1. Install Node 20\n2. Run npm ci",
          "reply": "setup.md read"
        },
        {
          "id": "r4",
          "as": "teammate",
          "text": "Find the checkout dashboard",
          "kind": "tool",
          "server": "grafana",
          "name": "search_dashboards",
          "args": {
            "query": "checkout"
          },
          "result": "checkout-latency (uid checkout-latency)",
          "reply": "1 dashboard found"
        }
      ],
      "schedule": [
        {
          "tick": 2,
          "event": "teammate-clones"
        }
      ],
      "solution": [
        {
          "tick": 1,
          "action": "sh",
          "args": [
            "claude mcp add filesystem --scope project -- npx -y @modelcontextprotocol/server-filesystem ./"
          ]
        },
        {
          "tick": 2,
          "action": "sh",
          "args": [
            "claude mcp add --transport http grafana https://grafana.example.com/mcp --scope project --header 'Authorization: Bearer ${GRAFANA_TOKEN}'"
          ]
        },
        {
          "tick": 3,
          "action": "serveTool"
        },
        {
          "tick": 4,
          "action": "serveTool"
        },
        {
          "tick": 5,
          "action": "serveTool"
        },
        {
          "tick": 6,
          "action": "serveTool"
        }
      ]
    },
    {
      "id": "scopes-secrets",
      "title": "2. Scopes and secrets",
      "blurb": "Add GitHub and the ticketing system. An old local entry is in the way, GitHub's README asks for an admin token, and each request needs the right primitive: a tool, a resource or a prompt.",
      "hints": [
        "Look at the wired servers: an old local tickets entry will shadow the project one.",
        "GitHub's README asks for an admin token, but it only needs to read issues, so bind the narrower variable. OAuth servers need /mcp auth.",
        "Remove the local tickets entry, add it at project scope and sign in, add github with -e bound to ${GITHUB_TOKEN}, then serve each request with its own primitive."
      ],
      "winTicks": 6,
      "catalog": [
        "filesystem",
        "github",
        "tickets"
      ],
      "env": [
        "GITHUB_TOKEN",
        "GITHUB_ADMIN_TOKEN"
      ],
      "files": {
        "project": {
          "filesystem": {
            "type": "stdio",
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-filesystem",
              "./"
            ],
            "env": {}
          }
        },
        "local": {
          "tickets": {
            "type": "http",
            "url": "https://tickets-staging.example.com/mcp"
          }
        },
        "user": {}
      },
      "oauth": [
        "tickets-staging"
      ],
      "requests": [
        {
          "id": "r1",
          "as": "you",
          "text": "Which issues are open on the repo?",
          "kind": "tool",
          "server": "github",
          "name": "list_issues",
          "args": {
            "owner": "acme",
            "repo": "shop",
            "state": "open"
          },
          "result": "#212 Checkout returns 500 on an empty cart\n#207 Flaky payment test\n#199 Update the on-call runbook",
          "reply": "3 open issues"
        },
        {
          "id": "r2",
          "as": "you",
          "text": "Pull ticket TCK-142 into the conversation",
          "kind": "resource",
          "server": "tickets",
          "name": "ticket://TCK-142",
          "args": {},
          "result": "# TCK-142: Checkout returns 500 on an empty cart\nStatus: open · Priority: high\nReported by sam@acme.example",
          "reply": "TCK-142 attached",
          "mime": "text/markdown"
        },
        {
          "id": "r3",
          "as": "you",
          "text": "Draft a bug report for the failing checkout test",
          "kind": "prompt",
          "server": "tickets",
          "name": "bug-report",
          "args": {
            "summary": "checkout test fails on an empty cart"
          },
          "result": "Write a bug report for: checkout test fails on an empty cart. Include steps to reproduce, expected and actual behaviour, and the relevant logs.",
          "reply": "bug-report template filled in"
