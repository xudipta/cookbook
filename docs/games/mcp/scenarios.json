    {
      "id": "vet-build",
      "title": "3. Vet and build",
      "blurb": "A teammate's commit adds a free word-count server. Read its tool descriptions before you approve anything, then build your own from the minimal-server blocks, test it with the inspector and plug it in.",
      "hints": [
        "Read the new free-utils server's tool descriptions in full before you approve anything.",
        "One description hides instructions aimed at the model, which is tool poisoning. Never approve a server you have not read.",
        "Reject free-utils, then in the builder choose the name count_words, a full description, a described input and a content result over stdio, save it and claude mcp add wordcount."
      ],
      "winTicks": 4,
      "catalog": [
        "filesystem",
        "github",
        "wordcount"
      ],
      "env": [
        "GITHUB_TOKEN"
      ],
      "files": {
        "project": {
          "filesystem": {
            "type": "stdio",
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-filesystem",
              "./"
            ],
            "env": {}
          },
          "github": {
            "type": "stdio",
            "command": "npx",
            "args": [
              "-y",
              "@modelcontextprotocol/server-github"
            ],
            "env": {
              "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
            }
          }
        },
        "local": {},
        "user": {}
      },
      "builder": {
        "file": "wordcount.js",
        "serverName": "wordcount",
        "knobs": [
          {
            "id": "name",
            "label": "Tool name",
            "options": [
              {
                "id": "count_words",
                "label": "count_words",
                "value": "count_words",
                "good": true
              },
              {
                "id": "words",
                "label": "words",
                "value": "words",
                "problem": "`words` is a noun. Name tools by action (`count_words`), so the model knows it is something to call."
              },
              {
                "id": "run",
                "label": "run",
                "value": "run",
                "problem": "`run` says nothing about what the tool does. Name tools by action (`count_words`)."
              }
            ]
          },
          {
            "id": "description",
            "label": "Description",
            "options": [
              {
                "id": "none",
                "label": "(none)",
                "value": "",
                "problem": "The tool has no description, and the model only has the description to go on."
              },
              {
                "id": "short",
                "label": "\"Counts words.\"",
                "value": "Counts words.",
                "problem": "\"Counts words.\" does not say when to use the tool or what it returns."
              },
              {
                "id": "full",
                "label": "what, when and what it returns",
                "value": "Count the words in a piece of text. Use it when asked how long a text is in words. Returns the number as text.",
                "good": true
              }
            ]
          },
          {
            "id": "input",
            "label": "Input schema",
            "options": [
              {
                "id": "any",
                "label": "text: z.any()",
                "code": "text: z.any()",
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {}
                  },
                  "required": [
                    "text"
                  ]
                },
                "problem": "`text` is untyped, so the model has to guess what to pass. Type every input."
              },
              {
                "id": "string",
                "label": "text: z.string()",
                "code": "text: z.string()",
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ]
                },
                "good": true
              },
              {
                "id": "described",
                "label": "text: z.string().describe(...)",
                "code": "text: z.string().describe(\"Text to count words in\")",
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "Text to count words in"
                    }
                  },
                  "required": [
                    "text"
                  ]
                },
                "good": true
              }
            ]
          },
          {
            "id": "result",
            "label": "Handler result",
            "options": [
              {
                "id": "echo",
                "label": "the whole text plus the count",
                "effect": "bloat",
                "code": [
                  "  async ({ text }) => {",
                  "    const n = text.trim().split(/\\s+/).length;",
                  "    return { content: [{ type: \"text\", text: `${text}\\n\\n(${n} words)` }] };",
                  "  },"
                ]
              },
              {
                "id": "number",
                "label": "the bare number",
                "effect": "invalid",
                "code": [
                  "  async ({ text }) => text.trim().split(/\\s+/).length,"
                ]
              },
              {
                "id": "content",
                "label": "content: [{ type: \"text\", text }]",
                "code": [
                  "  async ({ text }) => ({",
                  "    content: [{ type: \"text\", text: String(text.trim().split(/\\s+/).length) }],",
                  "  }),"
                ]
              }
            ]
          },
          {
            "id": "transport",
            "label": "Transport",
            "options": [
              {
                "id": "stdio",
                "label": "StdioServerTransport",
                "import": "import { StdioServerTransport } from \"@modelcontextprotocol/sdk/server/stdio.js\";",
                "code": "await server.connect(new StdioServerTransport());"
              },
              {
                "id": "http",
                "label": "StreamableHTTPServerTransport",
                "effect": "transport",
                "import": "import { StreamableHTTPServerTransport } from \"@modelcontextprotocol/sdk/server/streamableHttp.js\";",
                "code": "await server.connect(new StreamableHTTPServerTransport({ sessionIdGenerator: undefined })); // listens on http://localhost:3000/mcp"
              }
            ]
          }
        ],
        "defaults": {
          "name": "words",
          "description": "none",
          "input": "any",
          "result": "echo",
          "transport": "http"
        }
      },
